<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore only from nuget.org over HTTPS (S-05, S-08). Any machine-wide feed
    configured elsewhere is cleared so a build here cannot silently pull from an
    unexpected source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
